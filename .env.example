# ========================================
# Variáveis de Ambiente - Backend
# ========================================

# Porta do servidor
PORT=3000

# Environment
NODE_ENV=development

# Configurações OpenAI Whisper
OPENAI_API_KEY=sua_chave_aqui  # Opcional (Whisper offline funciona sem)

# Configurações HuggingFace (OBRIGATÓRIO)
HUGGINGFACE_TOKEN=hf_sua_chave_aqui

# Firebase (Opcional - para produção)
FIREBASE_PROJECT_ID=seu_projeto
FIREBASE_PRIVATE_KEY=sua_chave_privada
FIREBASE_CLIENT_EMAIL=sua_email

# Configurações de Áudio
SAMPLE_RATE=16000
AUDIO_FORMAT=wav
CHANNELS=1

# Configurações de Session
SESSION_TIMEOUT=3600  # 1 hora em segundos

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Processamento de Áudio
MAX_AUDIO_DURATION=600  # 10 minutos em segundos
CHUNK_SIZE=16000  # Número de samples por chunk

# Pyannote Settings
PYANNOTE_MODEL=pyannote/speaker-diarization-3.0
PYANNOTE_DEVICE=auto  # auto, cuda, cpu
